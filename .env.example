# development | homolog | production
APP_ENV=development

# Cartões-resposta: pasta tmp dos PDFs. Em Docker padrão=/app/tmp/answer_sheets;
# em WSL/dev local o código cai em /tmp/answer_sheets se /app não for gravável.
# ANSWER_SHEETS_TMP_BASE=/tmp/answer_sheets

# Sem worker Celery: força geração em thread local (HTTP 202; pode sair da página).
# ANSWER_SHEETS_FORCE_LOCAL=1

# Log por query SQL: tenant= user= endpoint= (debug). 1|true ou omitir com FLASK_DEBUG; 0 desliga
TENANT_QUERY_LOG=

# Frontend URL
FRONTEND_URL=http://localhost:8000

# JWT Secret Key (MUDE EM PRODUÇÃO!)
JWT_SECRET_KEY=your-secret-key-change-in-production

# SendGrid Email Service
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_ALERT_ENABLED=false

# Redis Password
REDIS_PASSWORD=redis_password

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_SERVER_URL=http://localhost:9000
